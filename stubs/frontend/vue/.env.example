# Template only — copy to `.env.local` for personal overrides (`fe dev --init-env` or `fe scaffold`).
# `fe dev` injects missing VITE_* at runtime and does not modify files unless you opt in.
#
# Persist autogenerated VITE_* on each dev run (optional):
#   fe dev --sync-env
#   or ENV_SERVER_SYNC=true in `.env.local` (ignored when set only in `.env`)
ENV_SERVER_SYNC=false
#
# Manual values (used when set; auto-detection fills gaps only at runtime):
# VITE_DEV_PORT=5174
# VITE_SERVER_URL=http://127.0.0.1:8000/my-shop
# VITE_DEV_SERVER=http://127.0.0.1:5174
# VITE_DEV_PROXY=/my-shop,/api,/uploads
#
# Prefer frontend.config.php dev.server_url / dev.proxy when possible.
